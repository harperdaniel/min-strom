{
  "name": "min-strom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @minstrom/api --filter @minstrom/web dev",
    "dev:api": "pnpm --filter @minstrom/api dev",
    "dev:web": "pnpm --filter @minstrom/web dev",
    "dev:worker": "pnpm --filter @minstrom/worker dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
